.venv/
__pycache__/
.pytest_cache/
data/cache/
.DS_Store
node_modules/
.wrangler/
.dev.vars

# Generated by scripts/make_share_images.py before each deploy
static/og/

# WhatsApp brand pack; only the green glyph is used, copied to static/icons/whatsapp.svg
static/icons/WhatsApp/

# ETH floor plans from plan.ethz.ch (internal, ETH login): only the JSON made from them is committed
assets/eth-plans/
# UZH's floor plans, kept out the same way
assets/uzh-plans/

# Mensa photos Raffaele drops in (any size): scripts/make_mensa_photos.py makes the small WebP tiles in static/mensa-photos/
assets/mensa-photos/
# Raffaele's source material: the mensa photos as collected (named by mensa) and ETH's and UZH's corporate design manuals
assets/mensa_images/
assets/corporate_design/

# Debug images from scripts/make_floors.py
build/

# Private: Claude Code's local notes (CLAUDE.local.md imports the infrastructure notes from the private repo)
CLAUDE.local.md

# ETH's floor plans aren't public until ETH agrees. scripts/floors.sh copies them in from the private repo for
# local work (static/.assetsignore keeps them off every upload); `scripts/floors.sh release` publishes them.
/static/map/floors/*
!/static/map/floors/index.json
/data/floors/*
!/data/floors/levels.json

# Images we may not publish (yet): they live in the private repo's private-assets/, and scripts/private_assets.sh
# copies them in (CI's deploy job too). Their lists (index.json, backgrounds.json, meals.json) stay public.
/static/mensa-photos/*.webp
/assets/share-backgrounds/UZH_*
